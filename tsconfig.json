{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "declaration": true,

    "verbatimModuleSyntax": true,

    "strict": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,

    "types": ["node"]
  },
  "include": ["src"]
}
