{
  "name": "war3-translate",
  "version": "0.0.14",
  "description": "node app to translate warcraft 3 maps",
  "license": "ISC",
  "author": "Mato <ily4368@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/1MaTo/war3-translate"
  },
  "bin": {
    "war3translate": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "index.mjs",
  "types": "./dist/index.d.mts",
  "imports": {
    "#shared/*.ts": "./src/shared/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "format": "oxfmt",
    "lint": "oxlint"
  },
  "dependencies": {
    "@effect/platform": "^0.96.0",
    "@effect/platform-node": "^0.106.0",
    "@jamiephan/stormlib": "^0.0.2",
    "better-sqlite3": "^12.8.0",
    "deepl-node": "^1.27.0",
    "effect": "^3.21.0",
    "google-translate-api-x": "^10.7.2",
    "immer": "^11.1.4"
  },
  "devDependencies": {
    "@effect/language-service": "^0.84.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "commander": "^14.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "tsdown": "^0.21.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*": [
      "pnpm format --no-error-on-unmatched-pattern",
      "pnpm lint --deny-warnings"
    ]
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
