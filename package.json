{
  "name": "war3-translate",
  "version": "0.0.1",
  "description": "node app to translate warcraft 3 maps",
  "license": "ISC",
  "author": "Ilya Kiselev <ily4368@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown --minify",
    "format": "oxfmt",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "tsdown": "^0.21.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*": [
      "pnpm format --no-error-on-unmatched-pattern",
      "pnpm lint --deny-warnings"
    ]
  },
  "packageManager": "pnpm@10.32.1"
}
